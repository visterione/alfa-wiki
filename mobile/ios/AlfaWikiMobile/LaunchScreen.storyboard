<?xml version="1.0" encoding="UTF-8"?>
<!--
  Экран запуска — то, что iOS показывает до первого кадра React Native.

  Раньше здесь лежала заготовка из шаблона: белое поле с надписями
  «AlfaWikiMobile» и «Powered by React Native». Старт выглядел как три разных
  приложения подряд — белый экран с чужим текстом, потом наш синий экран
  загрузки, потом интерфейс. На Android этот стык давно убран (см.
  res/drawable/splash_background.xml), теперь так же и здесь: тот же градиент и
  тот же знак, что на системном сплэше Android и на экране загрузки в JS.

  Градиента в сториборде нет как примитива, поэтому фон — растянутая картинка
  LaunchBackground: градиент плавный, растяжение на нём не читается.
  Знак — 128 pt, ровно как в SplashScreen внутри AppNavigator.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="BGr01vw1"/>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="LGo02vw2">
                                <constraints>
                                    <constraint firstAttribute="width" constant="128" id="LGow001"/>
                                    <constraint firstAttribute="height" constant="128" id="LGoh001"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.0" green="0.33725490196078434" blue="0.8" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <!-- Фон растянут по всему экрану, включая области под вырезом и
                                 жестовой полосой: safe area здесь не нужна, иначе по краям
                                 остались бы белые поля -->
                            <constraint firstItem="BGr01vw1" firstAttribute="top" secondItem="Ze5-6b-2t3" secondAttribute="top" id="BGt001"/>
                            <constraint firstItem="BGr01vw1" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="BGl001"/>
                            <constraint firstAttribute="trailing" secondItem="BGr01vw1" secondAttribute="trailing" id="BGr001"/>
                            <constraint firstAttribute="bottom" secondItem="BGr01vw1" secondAttribute="bottom" id="BGb001"/>
                            <constraint firstItem="LGo02vw2" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="LGcx001"/>
                            <constraint firstItem="LGo02vw2" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" id="LGcy001"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackground" width="1024" height="2048"/>
        <image name="LaunchLogo" width="128" height="128"/>
    </resources>
</document>
