# Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/

# Build outputs
dist/
build/
frontend/build/
frontend/dist/
backend/dist/

# Environment files
.env
.env.local
.env.development
.env.production
.env*.local
frontend/.env*
backend/.env*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editors
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Cache
.cache/
*.cache
.npm/
.eslintcache
.parcel-cache/

# Coverage
coverage/
*.lcov

# Uploads (если не нужны в репо)
uploads/
backend/uploads/

backend/backups/

# Database
*.sqlite
*.sqlite3
*.db

# Дампы БД — NEVER commit.
# В боевой базе персональные данные пациентов; однажды они уже уехали
# в публичный репозиторий именно отсюда.
*.sql
*.backup
*.dump
!backend/migrations/*.sql

# Temp files
tmp/
temp/
*.tmp
*.temp

# Рабочие файлы, на которых отлаживают импорт в ботах и парсере:
# прайсы, выгрузки, картинки. Никогда не часть кода.
backend/bot/*.csv
backend/bot/*.xlsx
backend/bot/*.xls
backend/bot/*.pdf
backend/bot/*.svg

# Package locks (оставь один - npm или yarn)
# package-lock.json
# yarn.lock

# Misc
*.pid
*.seed
*.pid.lock
.git/
backend/backups/backup-2026-01-07T09-02-42-344Z.zip

# SSL certificates (private key — NEVER commit)
/certs/
*.key
*.crt

# Firebase / FCM — приватные ключи push-уведомлений (NEVER commit)
backend/config/fcm-service-account.json
mobile/android/app/google-services.json
mobile/ios/GoogleService-Info.plist
